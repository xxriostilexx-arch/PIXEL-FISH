# Public app addresses – replace only after the HTTPS domain is live.
WEB_ORIGIN=https://app.seu-dominio.com
PUBLIC_APP_URL=https://app.seu-dominio.com

# Telegram: obtain at @BotFather. Never expose this value to the browser.
TELEGRAM_BOT_TOKEN=replace_me
TELEGRAM_BOT_USERNAME=replace_me_bot
NODE_ENV=production
AUTH_SESSION_TTL_HOURS=24
# Allows isolated zero-balance visitors only while the public site is not a Telegram Mini App.
WEB_GUEST_ACCESS=false

# Treasury: PUBLIC address only. Keep its seed phrase/private key offline.
TREASURY_TON_ADDRESS=UQ_REPLACE_WITH_YOUR_PUBLIC_TON_ADDRESS
USDT_JETTON_MASTER_ADDRESS=EQ_REPLACE_AFTER_NETWORK_VALIDATION

# Production persistence and worker.
# PostgreSQL nativo da VPS. Use 127.0.0.1 e uma senha codificada para URL.
DATABASE_URL=postgresql://pixelfish_app:replace_me@127.0.0.1:5432/pixelfish
REDIS_URL=redis://localhost:6379
ENABLE_REAL_WITHDRAWALS=false
# Manual payout workflow: keep false until you have an operator review process.
MANUAL_WITHDRAWALS_ENABLED=false
ADMIN_REVIEW_KEY=replace_with_a_long_random_secret
# CASH withdrawal economics. 10,000 CASH = US$1; withdrawals start at US$2.
CASH_PER_USD=10000
MIN_WITHDRAWAL_USD=1.56
MIN_WITHDRAWAL_CASH=15600
WITHDRAWAL_FEE_PERCENT=5
DAILY_WITHDRAWAL_USD_LIMIT=100
MAX_WITHDRAWAL_CASH=10000000
WITHDRAWAL_PRICE_CACHE_SECONDS=60
STATE_PERSIST_DEBOUNCE_MS=3000
# Optional. Without it, the server uses Binance's public TON/USDT market feed.
# With it, CoinGecko becomes the preferred primary source.
COINGECKO_DEMO_API_KEY=
PORT=8787
